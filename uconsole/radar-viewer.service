# systemd user unit for the RadarLink viewer on the uConsole.
#
#   mkdir -p ~/.config/systemd/user
#   cp radar-viewer.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now radar-viewer
#
# Adjust the paths and, when using a Wayland session, replace the DISPLAY line
# with Environment=SDL_VIDEODRIVER=wayland and the matching WAYLAND_DISPLAY.
[Unit]
Description=RadarLink radar/LIDAR viewer
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Arduino-ESP32-Radarproject/uconsole
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 %h/Arduino-ESP32-Radarproject/uconsole/radar_viewer.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
